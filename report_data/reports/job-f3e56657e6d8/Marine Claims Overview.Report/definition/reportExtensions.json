{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Claim Vessels",
      "measures": [
        {
          "name": "Claims",
          "dataType": "Integer",
          "expression": "DISTINCTCOUNT('Claim Vessels'[Claim Number])",
          "formatString": "#,##0"
        },
        {
          "name": "Open Claims",
          "dataType": "Integer",
          "expression": "CALCULATE(DISTINCTCOUNT('Claim Vessels'[Claim Number]), 'Claim'[Is Open Claim] = TRUE())",
          "formatString": "#,##0"
        },
        {
          "name": "Incurred (m)",
          "dataType": "Double",
          "expression": "DIVIDE([Total Incurred], 1000000)",
          "formatString": "#,##0.0"
        },
        {
          "name": "Paid (m)",
          "dataType": "Double",
          "expression": "DIVIDE([Total Paid], 1000000)",
          "formatString": "#,##0.0"
        },
        {
          "name": "Outstanding (m)",
          "dataType": "Double",
          "expression": "DIVIDE([Total Outstanding], 1000000)",
          "formatString": "#,##0.0"
        }
      ]
    }
  ]
}