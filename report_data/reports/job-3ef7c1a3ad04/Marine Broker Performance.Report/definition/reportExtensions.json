{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Claim Vessels",
      "measures": [
        {
          "name": "Claims",
          "dataType": "Integer",
          "expression": "DISTINCTCOUNT('Claim Vessels'[Claim Number])",
          "formatString": "#,##0"
        },
        {
          "name": "Brokers with Claims",
          "dataType": "Integer",
          "expression": "CALCULATE(DISTINCTCOUNT('Broker'[Broker ID]), 'Claim Vessels', 'Broker'[Broker ID] <> \"UNKNOWN\")",
          "formatString": "#,##0"
        },
        {
          "name": "Avg Commission %",
          "dataType": "Double",
          "expression": "CALCULATE(AVERAGE('Broker'[Commission %]), 'Claim Vessels')",
          "formatString": "0.0%"
        },
        {
          "name": "Incurred (m)",
          "dataType": "Double",
          "expression": "DIVIDE([Total Incurred], 1000000)",
          "formatString": "#,##0.0"
        },
        {
          "name": "Paid (m)",
          "dataType": "Double",
          "expression": "DIVIDE([Total Paid], 1000000)",
          "formatString": "#,##0.0"
        }
      ]
    }
  ]
}