/// One row per claim_number (G2), with an UNKNOWN member. gold.marine_dim_claim.
table Claim

	/// Number of claims, excluding the UNKNOWN member.
	measure '# Claims' = CALCULATE(COUNTROWS('Claim'), 'Claim'[Claim Number] <> "UNKNOWN")
		formatString: #,##0
		displayFolder: Counts

	/// KPI-OPEN-REOPENED: claims where is_open_claim is TRUE; NULL is not counted.
	measure '# Claims (Open Claim)' = CALCULATE(COUNTROWS('Claim'), 'Claim'[Is Open Claim] = TRUE())
		formatString: #,##0
		displayFolder: Indicators

	/// KPI-OPEN-REOPENED: claims where is_reopened_claim is TRUE; NULL is not counted.
	measure '# Claims (Reopened Claim)' = CALCULATE(COUNTROWS('Claim'), 'Claim'[Is Reopened Claim] = TRUE())
		formatString: #,##0
		displayFolder: Indicators

	/// KPI-GA: claims where general_average_declared is TRUE; NULL is not counted.
	measure '# Claims (General Average Declared)' = CALCULATE(COUNTROWS('Claim'), 'Claim'[General Average Declared] = TRUE())
		formatString: #,##0
		displayFolder: Indicators

	column 'Claim Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: claim_sk

	column 'Claim Number'
		dataType: string
		summarizeBy: none
		sourceColumn: claim_number

	column 'Cause of Loss'
		dataType: string
		summarizeBy: none
		sourceColumn: cause_of_loss

	column 'Claim Status'
		dataType: string
		summarizeBy: none
		sourceColumn: claim_status

	column 'Claim Type'
		dataType: string
		summarizeBy: none
		sourceColumn: claim_type

	column 'Loss Location'
		dataType: string
		summarizeBy: none
		sourceColumn: loss_location

	column 'General Average Declared'
		dataType: boolean
		summarizeBy: none
		sourceColumn: general_average_declared

	column 'Is Open Claim'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_open_claim

	column 'Is Reopened Claim'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_reopened_claim

	column 'Gold Run ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_run_id

	column 'Gold Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_timestamp

	partition Claim = entity
		mode: directLake
		source
			entityName: marine_dim_claim
			schemaName: gold
			expressionSource: 'DirectLake - Marine_Gold_Model'

