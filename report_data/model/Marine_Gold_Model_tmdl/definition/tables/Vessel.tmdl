/// One row per imo_number (conformed: claim + policy IMOs; vessel_type from claims only - S3) (G2), with an UNKNOWN member. gold.marine_dim_vessel.
table Vessel

	/// Number of vessels, excluding the UNKNOWN member.
	measure '# Vessels' = CALCULATE(COUNTROWS('Vessel'), 'Vessel'[IMO Number] <> "UNKNOWN")
		formatString: #,##0
		displayFolder: Counts

	column 'Vessel Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: vessel_sk

	column 'IMO Number'
		dataType: string
		summarizeBy: none
		sourceColumn: imo_number

	column 'Vessel Type'
		dataType: string
		summarizeBy: none
		sourceColumn: vessel_type

	column 'Gold Run ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_run_id

	column 'Gold Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_timestamp

	partition Vessel = entity
		mode: directLake
		source
			entityName: marine_dim_vessel
			schemaName: gold
			expressionSource: 'DirectLake - Marine_Gold_Model'

