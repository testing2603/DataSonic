/// Role-playing calendar (G6); the UNKNOWN row holds missing dates. gold.marine_dim_date.
table Date
	dataCategory: Time

	column 'Date Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: date_sk

	column Date
		dataType: dateTime
		formatString: yyyy/mm/dd
		summarizeBy: none
		sourceColumn: date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column Quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column Month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day

	column 'Gold Run ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_run_id

	column 'Gold Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_timestamp

	hierarchy Calendar

		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: Month

		level Day
			column: Day

	partition Date = entity
		mode: directLake
		source
			entityName: marine_dim_date
			schemaName: gold
			expressionSource: 'DirectLake - Marine_Gold_Model'

