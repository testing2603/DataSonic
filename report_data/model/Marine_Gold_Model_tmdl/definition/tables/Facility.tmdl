/// One row per facility_id (G2), with an UNKNOWN member. gold.marine_dim_facility.
table Facility

	/// Number of facilities, excluding the UNKNOWN member.
	measure '# Facilities' = CALCULATE(COUNTROWS('Facility'), 'Facility'[Facility ID] <> "UNKNOWN")
		formatString: #,##0
		displayFolder: Counts

	column 'Facility Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: facility_sk

	column 'Facility ID'
		dataType: string
		summarizeBy: none
		sourceColumn: facility_id

	column 'Facility Name'
		dataType: string
		summarizeBy: none
		sourceColumn: facility_name

	column 'Gold Run ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_run_id

	column 'Gold Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_timestamp

	partition Facility = entity
		mode: directLake
		source
			entityName: marine_dim_facility
			schemaName: gold
			expressionSource: 'DirectLake - Marine_Gold_Model'

