/// Grain: One row per settlement movement (claim_number, last_transaction_date); imo_number splits multi-vessel groups. gold.marine_fact_claim_settlement_txn (G1).
table 'Claim Settlement Transactions'

	/// Rows of Claim Settlement Transactions. Grain: One row per settlement movement (claim_number, last_transaction_date); imo_number splits multi-vessel groups.
	measure '# Claim Settlement Transactions' = COUNTROWS('Claim Settlement Transactions')
		formatString: #,##0
		displayFolder: Counts

	/// Currency check: claim_currency values in context. Money of Claim Settlement Transactions shows only when this is 1.
	measure '# Currencies (Claim Settlement Transactions)' = COUNTROWS(VALUES('Claim Settlement Transactions'[Settlement Currency]))
		formatString: #,##0
		displayFolder: Checks

	/// Sum of settlement_amount (ROW); blank unless one currency is in context; no FX.
	measure 'Total Settlements' = IF(COUNTROWS(VALUES('Claim Settlement Transactions'[Settlement Currency])) = 1, SUM('Claim Settlement Transactions'[Settlement Amount]))
		formatString: #,##0.00
		displayFolder: Amounts

	column 'Claim Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: claim_sk

	column 'Policy Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: policy_sk

	column 'Vessel Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: vessel_sk

	column 'Customer Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: customer_sk

	column 'Broker Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: broker_sk

	column 'Facility Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: facility_sk

	column 'Claim Number'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: claim_number

	column 'IMO Number'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: imo_number

	column 'Policy Number'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: policy_number

	column 'Settlement Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: settlement_amount

	column 'Gold Run ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_run_id

	column 'Gold Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: _gold_timestamp

	column 'Last Transaction Date Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: last_transaction_date_sk

	column 'Last Transaction Date'
		dataType: dateTime
		isHidden
		formatString: yyyy/mm/dd hh:nn:ss
		summarizeBy: none
		sourceColumn: last_transaction_date

	column Comment
		dataType: string
		summarizeBy: none
		sourceColumn: comment

	column 'Settlement Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: claim_currency

	partition 'Claim Settlement Transactions' = entity
		mode: directLake
		source
			entityName: marine_fact_claim_settlement_txn
			schemaName: gold
			expressionSource: 'DirectLake - Marine_Gold_Model'

